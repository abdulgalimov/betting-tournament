{
  "name": "tournament",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle/migrations"
  ],
  "scripts": {
    "build": "rspack build --config rspack.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "dlq:redrive": "node --env-file-if-exists=.env dist/redrive-dlq.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS='' node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.4.0",
    "drizzle-orm": "0.45.4",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-loki": "3.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rspack/cli": "2.3.3",
    "@rspack/core": "2.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "webpack-node-externals": "3.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12 <13"
  }
}
