PORT=3000
# Demo-only credentials. Replace for any shared environment.
POSTGRES_USER=tournament
POSTGRES_PASSWORD=tournament
POSTGRES_DB=tournament

RABBITMQ_DEFAULT_USER=tournament
RABBITMQ_DEFAULT_PASS=tournament
RABBITMQ_URL=amqp://tournament:tournament@localhost:5672
# Optional RabbitMQ topology and consumer settings; defaults shown below.
RABBITMQ_EXCHANGE=bets
RABBITMQ_QUEUE=tournament.bets
RABBITMQ_DEAD_LETTER_EXCHANGE=bets.dlx
RABBITMQ_DEAD_LETTER_QUEUE=tournament.bets.dlq
RABBITMQ_DEAD_LETTER_ROUTING_KEY=failed
RABBITMQ_PREFETCH=1000
RABBITMQ_MAX_DELIVERY_ATTEMPTS=5

DATABASE_URL=postgresql://tournament:tournament@localhost:5432/tournament
# Event-write pool: batch transactions plus the outage probe.
DATABASE_MAX_POOL=8
# Events per write transaction and concurrent batches; their product is at most 2000.
EVENT_BATCH_SIZE=250
EVENT_BATCH_CONCURRENCY=2
# Separate pool for GET /leaderboard: when it is saturated the API answers 503 fast
# instead of taking connections from event processing.
DATABASE_HTTP_MAX_POOL=8
DATABASE_HTTP_STATEMENT_TIMEOUT_MS=2000
DATABASE_HTTP_CONNECTION_TIMEOUT_MS=1000

TEST_DATABASE_URL=postgresql://tournament:tournament@localhost:5432/tournament
TEST_RABBITMQ_URL=amqp://tournament:tournament@localhost:5672
# USD per one currency unit; fixed demo rates, never fetch rates implicitly.
EXCHANGE_RATES=USD=1;EUR=1.1;RUB=0.01
LOG_LEVEL=error
# OpenTelemetry metrics for running the tournament on the host (pnpm dev/start).
NODE_OPTIONS=--experimental-loader=@opentelemetry/instrumentation/hook.mjs --import=@opentelemetry/auto-instrumentations-node/register
OTEL_SERVICE_NAME=tournament
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Listener address reachable by Docker Desktop, without a URL scheme.
OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
OTEL_EXPORTER_PROMETHEUS_PORT=9464
# Optional Loki push URL; in Docker Compose use http://loki:3100.
# Leave empty to collect container stdout through Alloy only.
LOKI_URL=http://localhost:3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
