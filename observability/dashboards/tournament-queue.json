    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Каждый столбец показывает обработанные сообщения tournament.bets за интервал времени (зелёный сегмент) и число ожидающих обработки в этот момент (оранжевый сегмент, без unacked). Обработано — оценка прироста подтверждений ACK за интервал, а не накопительный итог. Длительность интервала зависит от масштаба графика и составляет не менее 15 секунд.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "сообщений",
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "green", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "orange", "mode": "fixed" }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "id": 11,
      "interval": "15s",
      "maxDataPoints": 120,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(increase(rabbitmq_detailed_queue_messages_acked_total{job=\"rabbitmq-queue\",queue=\"tournament.bets\"}[$__interval])) or vector(0)",
          "legendFormat": "Обработано за интервал",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{job=\"rabbitmq-queue\",queue=\"tournament.bets\"}) or vector(0)",
          "legendFormat": "Ожидают обработки",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Ожидают обработки и обработано за интервал",
      "type": "timeseries"
    }
