  "description": "Время запроса PostgreSQL и полного ответа GET /leaderboard.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Среднее время и p95 выполнения запроса leaderboard к PostgreSQL с запуска приложения.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "секунды",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 11,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(tournament_leaderboard_query_duration_sum) / sum(tournament_leaderboard_query_duration_count)",
          "legendFormat": "Среднее",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (tournament_leaderboard_query_duration_bucket))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Время SQL-запроса leaderboard (с запуска)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Среднее время и p95 обработки GET /leaderboard с запуска приложения. Сервер измеряет время от получения запроса до отправки HTTP-ответа.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "секунды",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "id": 12,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(tournament_leaderboard_response_duration_sum) / sum(tournament_leaderboard_response_duration_count)",
          "legendFormat": "Среднее",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (tournament_leaderboard_response_duration_bucket))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Время ответа GET /leaderboard (с запуска)",
      "type": "timeseries"
    }
  ],
